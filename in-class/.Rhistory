# Get question text
# TIP: reuse this code but change "Q1.1" for the question in which you are interested
q_text %>%
filter(Q == "Q1.1") %>%
select(Text)
# Generate counts of each response to Q1.1
survey_df %>%
count(Q1.1)
# Get question text
# TIP: reuse this code but change "Q1.1" for the question in which you are interested
q_text %>%
filter(Q == "Q1.1b") %>%
select(Text)
# Generate see each response to Q1.1b
survey_df %>%
select(Q1.1b)
# Get question text
# TIP: reuse this code but change "Q1.1" for the question in which you are interested
q_text %>%
filter(Q == "Q1.3") %>%
select(Text)
